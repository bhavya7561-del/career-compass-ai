# Copy this file to .env and fill in real values. Never commit .env itself.

GEMINI_API_KEY=your_gemini_api_key_here

# Used by database.py
DATABASE_URL=sqlite:///./database/career.db

# Optional: override the Gemini model without editing code.
# Defaults to gemini-3.6-flash (current stable flash model) if unset.
# GEMINI_MODEL=gemini-3.6-flash
